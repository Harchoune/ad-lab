<!--
  Règles Wazuh personnalisées — détection de brute force d'authentification sur DC01.
  À déposer dans /var/ossec/etc/rules/local_rules.xml sur le manager Wazuh.

  Prérequis de collecte : l'agent Wazuh sur DC01 remonte le canal Security des
  Windows Event Logs (voir ossec.conf.sample). Les échecs d'ouverture de session
  Windows (Event ID 4625) sont décodés par les règles officielles Windows de Wazuh
  (groupe windows, règle de base 60122) ; on ajoute ici la corrélation « répétition ».

  ⚠️ MODÈLE à valider : vérifier les ID de règles parentes réellement déclenchées
     dans votre version de Wazuh avec wazuh-logtest (voir captures/TODO-PREUVE_wazuh.md).
-->
<group name="local,windows,authentication_failures,">

  <!-- Échec d'authentification Windows isolé (4625) : on s'appuie sur le décodage
       Windows natif de Wazuh et on le requalifie pour le lab. -->
  <rule id="100200" level="5">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4625$</field>
    <description>Windows : échec d'ouverture de session (4625) sur $(win.system.computer).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- Brute force : plusieurs 4625 pour une même source sur une courte fenêtre. -->
  <rule id="100201" level="10" frequency="8" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <same_source_ip />
    <description>Brute force probable : échecs 4625 répétés depuis une même source.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>brute_force,</group>
  </rule>

  <!-- Compte verrouillé (4740) : conséquence du seuil de verrouillage (Pol-Verrouillage). -->
  <rule id="100202" level="10">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">^4740$</field>
    <description>Compte verrouillé après échecs répétés (4740) sur $(win.system.computer).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>brute_force,account_lockout,</group>
  </rule>

</group>

